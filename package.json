{
  "name": "anythingxpress-node",
  "version": "2.0.0",
  "private": true,
  "description": "AnythingXpress native Node.js rebuild",
  "main": "app.bundle.cjs",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node app.bundle.cjs server",
    "dev": "node --watch src/server.js",
    "migrate": "node migrate.bundle.cjs",
    "check": "node --check app.bundle.cjs && node --check migrate.bundle.cjs",
    "test": "node --test tests/*.test.js",
    "cron:sms": "node app.bundle.cjs cron:sms",
    "cron:whitelist": "node app.bundle.cjs cron:whitelist"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-flash": "^0.1.1",
    "dotenv": "^17.2.2",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.0",
    "multer": "^2.0.2",
    "nanoid": "^5.1.5"
  }
}
